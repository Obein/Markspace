{
  "name": "markspace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Markspace - Lightweight Privacy-First Edge Responsive Markdown Notes App",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:ui": "npm run dev --workspace=apps/ui",
    "build:ui": "npm run build --workspace=apps/ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run build:ui && npm run deploy --workspace=apps/api",
    "d1:create": "npm run d1:create --workspace=apps/api",
    "d1:migrate:local": "npm run d1:migrate:local --workspace=apps/api",
    "d1:migrate:prod": "npm run d1:migrate:prod --workspace=apps/api"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}

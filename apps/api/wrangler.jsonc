{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "markspace",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "../ui/dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "markspace-db",
			// The database_id is generated when you create a D1 database in the Cloudflare dashboard.
			// You can find it in the "Settings" tab of your database.
			"database_id": "0580cc6e-6965-4f14-88d6-c74f25c61c85",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "markspace-media-bucket"
		}
	],
	"vars": {
		// The JWT_SECRET is used for signing and verifying JSON Web Tokens (JWTs).
		// In production, you should replace this with a secure, random string.
		// "JWT_SECRET": "default-markspace-jwt-secret-replace-in-prod",
		// The TOTP_SECRET is used for generating Time-based One-Time Passwords (TOTP) for two-factor authentication.
		// In production, you should replace this with a secure, random string.
		// "MASTER_ENCRYPTION_KEY": "default-markspace-master-encryption-key-replace-in-prod",
		"ENVIRONMENT": "production"
	}
}

{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "markspace",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "../ui/dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "markspace-db",
			// The database_id is generated when you create a D1 database in the Cloudflare dashboard.
			// You can find it in the "Settings" tab of your database.
			"database_id": "3437fa71-7efd-48c3-bd1b-0204d07cb631",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "markspace-media-bucket"
		}
	],
	"vars": {
		// "JWT_SECRET": "default-markspace-jwt-secret-replace-in-prod",
		// "MASTER_ENCRYPTION_KEY": "default-markspace-master-encryption-key-replace-in-prod",
		"ENVIRONMENT": "production"
	}
}